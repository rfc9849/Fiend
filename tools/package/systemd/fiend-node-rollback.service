[Unit]
Description=Restore the previous fiend node
ConditionPathExists=/opt/fiend/bin/fiend-core.prev

[Service]
Type=oneshot
ExecStart=/opt/fiend/bin/fiend-rollback
ExecStartPost=/usr/bin/systemctl reset-failed fiend-node.service
ExecStartPost=/usr/bin/systemctl --no-block start fiend-node.service
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/fiend/bin
RestrictAddressFamilies=AF_UNIX
UMask=0077

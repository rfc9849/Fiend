[Unit]
Description=fiend node
After=network-online.target
Wants=network-online.target
OnFailure=fiend-node-rollback.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=fiend
Group=fiend
ExecStartPre=+/opt/fiend/bin/fiend-activate-update
ExecStartPre=/opt/fiend/bin/fiend-core check /etc/fiend/node.toml
ExecStart=/opt/fiend/bin/fiend-node
Restart=always
RestartSec=2
TimeoutStopSec=15
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/fiend /run/fiend
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RuntimeDirectory=fiend
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077

[Install]
WantedBy=multi-user.target

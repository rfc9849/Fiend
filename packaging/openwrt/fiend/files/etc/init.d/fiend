#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/fiend-daemon
STORE=/etc/fiend
RUN=/var/run/fiend

add_network() {
	local device
	. /lib/functions/network.sh
	network_get_device device "$1" || device=$(uci -q get "network.$1.device")
	[ -n "$device" ] && procd_append_param command --lan "$device"
}

start_service() {
	local dns_redirect

	config_load fiend
	config_get_bool dns_redirect main dns_redirect 1

	procd_open_instance
	procd_set_param command "$PROG" run --store "$STORE"
	config_list_foreach main network add_network
	[ "$dns_redirect" = 1 ] && procd_append_param command --dns-redirect
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 20
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_stopped() {
	"$PROG" restore --store "$RUN" >/dev/null 2>&1
}

service_triggers() {
	local network

	procd_add_reload_trigger fiend
	config_load fiend
	config_get network main network
	for network in $network; do
		procd_add_interface_trigger "interface.*.up" "$network" /etc/init.d/fiend reload
	done
}

    <string name="rules_syntax_direct">One rule per line. domain: matches the name and its subdomains. full: matches one name. keyword: matches part of a name. ip: matches an address range. # starts a comment.</string>
    <string name="rules_syntax_block">One rule per line. domain: matches the name and its subdomains. full: matches one name. keyword: matches part of a name. # starts a comment.</string>
    <string name="rules_example_proxy">domain:example.com\nfull:www.example.org\nkeyword:example\nip:203.0.113.0/24</string>
    <string name="rules_example_dpi">domain:googlevideo.com\ndomain:youtube.com\nfull:discord.com\nip:203.0.113.0/24</string>
    <string name="rules_syntax_dpi">One rule per line. domain: matches the name and its subdomains. full: matches one name. keyword: matches part of a name. ip: matches an address range. A proxy rule wins over a bypass DPI rule, and a bypass DPI rule wins over a direct rule. # starts a comment.</string>
    <string name="rules_syntax_proxy">One rule per line. domain: matches the name and its subdomains. full: matches one name. keyword: matches part of a name. ip: matches an address range. A proxy rule wins over a direct rule. # starts a comment.</string>
